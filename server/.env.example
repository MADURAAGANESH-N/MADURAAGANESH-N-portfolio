# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/maduraaganesh_portfolio

# JWT Secret Key for Admin Authentication (Generate a strong random 32+ char string in production)
JWT_SECRET=your_super_secret_jwt_key_replace_in_production_32_characters_minimum

# Optional: GitHub Personal Access Token to increase public API rate limit from 60 to 5,000 req/hr
# Public repositories are fetched without this token. Keep this server-side ONLY.
GITHUB_TOKEN=

# Frontend Client URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# Default Admin Seed Credentials
ADMIN_EMAIL=nmaduraaganesh@gmail.com
ADMIN_PASSWORD=Admin@ZohoAI2026
